{
  "name": "markdown-editor",
  "version": "1.0.3",
  "description": "A local Markdown editor built with Electron",
  "main": "main.js",
  "scripts": {
    "build:renderer": "esbuild src/renderer/main.js --bundle --outfile=renderer/app.js --format=iife --platform=browser --target=chrome120 --sourcemap",
    "watch:renderer": "esbuild src/renderer/main.js --bundle --outfile=renderer/app.js --format=iife --platform=browser --target=chrome120 --sourcemap --watch",
    "start": "npm run build:renderer && electron .",
    "smoke": "npm run build:renderer && electron . --smoke-test",
    "pack": "npm run build:renderer && electron-builder --dir",
    "dist": "npm run build:renderer && electron-builder --publish never",
    "build:win": "npm run build:renderer && electron-builder --win --publish never",
    "build:mac": "npm run build:renderer && electron-builder --mac --publish never",
    "build:mac:universal": "npm run build:renderer && electron-builder --mac --universal --publish never",
    "icon": "node scripts/make-icon.js"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.4",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.11",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.15",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "highlight.js": "^11.12.0",
    "lucide": "^1.43.0",
    "marked": "^18.0.12",
    "sharp": "^0.35.4"
  }
}
